@* Renginių rekomendacijų langas *@
@model List<RenginioRekomendacija>
@{
    ViewData["Title"] = "Renginių rekomendacijos";
    string role = Context.Request.Cookies["Role"];
    bool sistemaPasiekiama = ViewBag.SistemaPasiekiama ?? true;
}

<h1 class="h3 mb-3">Rekomenduojami renginiai</h1>

@if (role != "Registruotas")
{
    <div class="alert alert-warning">Funkcija prieinama tik registruotam naudotojui.</div>
}
else
{
    <p class="text-muted">
        Atrinkta pagal jūsų mėgstamas sporto šakas (@string.Join(", ", RenginiuDemoDuomenys.NaudotojoMegstamosSakos))
        ir peržiūrėtus renginius.
    </p>

    @if (!sistemaPasiekiama)
    {
        <div class="alert alert-warning">
            Žemėlapių sistema nepasiekiama, todėl atstumai nerodomi.
            <a asp-action="Rekomendacijos">Bandyti dar kartą</a>
        </div>
    }

    @if (Model.Count == 0)
    {
        <p class="text-muted">Tinkamų renginių nerasta.</p>
    }
    else
    {
        <table class="table table-hover align-middle">
            <thead>
                <tr>
                    <th>Renginys</th>
                    <th>Data</th>
                    @if (sistemaPasiekiama)
                    {
                        <th class="text-nowrap">Atstumas</th>
                    }
                </tr>
            </thead>
            <tbody>
                @foreach (RenginioRekomendacija rekomendacija in Model)
                {
                    <tr>
                        <td>
                            <a class="vietos-nuoroda" asp-action="Informacija" asp-route-id="@rekomendacija.Renginys.Id">@rekomendacija.Renginys.Pavadinimas</a>
                            <div class="small text-muted">@rekomendacija.Renginys.SportoSaka · @rekomendacija.Renginys.Vieta</div>
                        </td>
                        <td class="text-nowrap">@rekomendacija.Renginys.PradziosData.ToString("yyyy-MM-dd")</td>
                        @if (sistemaPasiekiama)
                        {
                            <td class="text-nowrap">
                                @if (rekomendacija.Kelione != null)
                                {
                                    <span>@rekomendacija.Kelione.AtstumasKm km · @rekomendacija.Kelione.TrukmeMin min</span>
                                }
                                else
                                {
                                    <span class="text-muted">–</span>
                                }
                            </td>
                        }
                    </tr>
                }
            </tbody>
        </table>
    }

    @if (sistemaPasiekiama)
    {
        <p class="small text-muted">
            Prototipe: <a asp-action="Rekomendacijos" asp-route-zemelapiai="nepasiekiama">parodyti, kai žemėlapių sistema nepasiekiama</a>
        </p>
    }
}
