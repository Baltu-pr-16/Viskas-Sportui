@{ ViewData["Title"] = "Treniruotės sudarymas"; }
<h2>Treniruotės sudarymas</h2>
<form>
    <div class="mb-3"><label class="form-label">Programa</label><select class="form-select"><option>Bėgimo pradžiamokslis</option><option>Jėgos pagrindai</option></select></div>
    <div class="mb-3"><label class="form-label">Tikslas</label><input class="form-control" /></div>
    <div class="mb-3"><label class="form-label">Trukmė (min.)</label><input type="number" class="form-control" /></div>
    <div class="mb-3"><label class="form-label">Intensyvumas</label><input class="form-control" /></div>
    <a class="btn btn-primary" asp-action="TreniruotesPlanas">Sudaryti treniruotę</a>
    <a class="btn btn-outline-secondary" asp-controller="Home" asp-action="Index">Atšaukti</a>
</form>
