@model IEnumerable<ViskasSportui.Models.PrekesPasiulymas>

@{
    ViewData["Title"] = "Pasiūlymų sąrašas";
    var ieskotaPreke = ViewBag.IeskotaPreke as ViskasSportui.Models.SportoPreke;
}

<h2>Rasti pasiūlymai</h2>

@if (ieskotaPreke != null && !string.IsNullOrEmpty(ieskotaPreke.Pavadinimas))
{
    <p class="lead">Paieškos rezultatai prekei: <strong>@ieskotaPreke.Gamintojas @ieskotaPreke.Pavadinimas @ieskotaPreke.Modelis</strong></p>
}

<hr />

<table class="table table-striped table-hover">
    <thead>
        <tr>
            <th>Kaina (€)</th>
            <th>Surinkimo data</th>
            <th>Būsena</th>
            <th>Nuoroda</th>
        </tr>
    </thead>
    <tbody>
        @if (Model != null && Model.Any())
        {
            foreach (var pasiulymas in Model)
            {
                <tr>
                    <td class="fw-bold text-success">@pasiulymas.Kaina.ToString("F2") €</td>
                    <td>@pasiulymas.SurinkimoData.ToString("yyyy-MM-dd")</td>
                    <td>
                        @if (pasiulymas.Prieinama)
                        {
                            <span class="badge bg-success">Prieinama</span>
                        }
                        else
                        {
                            <span class="badge bg-danger">Išparduota</span>
                        }
                    </td>
                    <td>
                        <a href="@pasiulymas.Nuoroda" target="_blank" class="btn btn-sm btn-outline-primary">Eiti į parduotuvę</a>
                    </td>
                </tr>
            }
        }
        else
        {
            <tr>
                <td colspan="4" class="text-center text-muted py-3">Pasiūlymų nerasta.</td>
            </tr>
        }
    </tbody>
</table>

<div class="mt-3">
    <a asp-action="Perziura" class="btn btn-secondary">Grįžti į prekių sąrašą</a>
</div>