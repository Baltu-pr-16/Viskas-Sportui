@model ViskasSportui.Models.SportoPreke

@{
    ViewData["Title"] = "Redaguoti";
}

<h1>Redaguoti prekę</h1>

<h4>Sporto prekė</h4>
<hr />
<div class="row">
    <div class="col-md-4">
        <form asp-action="Redaguoti">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <input type="hidden" asp-for="Id" />
            <div class="form-group">
                <label asp-for="Pavadinimas" class="control-label"></label>
                <input asp-for="Pavadinimas" class="form-control" />
                <span asp-validation-for="Pavadinimas" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Gamintojas" class="control-label"></label>
                <input asp-for="Gamintojas" class="form-control" />
                <span asp-validation-for="Gamintojas" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Modelis" class="control-label"></label>
                <input asp-for="Modelis" class="form-control" />
                <span asp-validation-for="Modelis" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Aprasymas" class="control-label"></label>
                <input asp-for="Aprasymas" class="form-control" />
                <span asp-validation-for="Aprasymas" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Kategorija" class="control-label"></label>
                <input asp-for="Kategorija" class="form-control" />
                <span asp-validation-for="Kategorija" class="text-danger"></span>
            </div>
            <div class="form-group">
                <input type="submit" value="Išsaugoti" class="btn btn-primary" />
            </div>
        </form>
    </div>
</div>

<div>
    <a asp-action="Perziura">Grįžti į sąrašą</a>
</div>