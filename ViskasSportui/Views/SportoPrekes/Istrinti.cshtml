@model ViskasSportui.Models.SportoPreke

@{
    ViewData["Title"] = "Istrinti";
}

<h1>Ištrinti prekę</h1>

<h3>Ar tikrai norite ištrinti šią prekę?</h3>
<div>
    <hr />
    <dl class="row">
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.Pavadinimas)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.Pavadinimas)
        </dd>
    </dl>
    <dl class="row">
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.Gamintojas)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.Gamintojas)
        </dd>
    </dl>
    <dl class="row">
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.Modelis)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.Modelis)
        </dd>
    </dl>
    <dl class="row">
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.Aprasymas)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.Aprasymas)
        </dd>
    </dl>
    <dl class="row">
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.Kategorija)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.Kategorija)
        </dd>
    </dl>
    <form asp-action="Istrinti">
        <input type="hidden" asp-for="Id" />
        <input type="submit" value="Ištrinti" class="btn btn-danger" /> |
        <a asp-action="Perziura">Grįžti į sąrašą</a>
    </form>
</div>
