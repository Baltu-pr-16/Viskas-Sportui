@{
    // Imituojama naudotojo rolė: null = svečias, "Registruotas" arba "Administratorius"
    string role = Context.Request.Cookies["Role"];

    // Kuris langas dabar atidarytas – pagal tai meniu punktas pažymimas žaliu pabraukimu
    string valdiklis = ViewContext.RouteData.Values["controller"].ToString();
    string veiksmas = ViewContext.RouteData.Values["action"].ToString();

    string sportoVietuKlase = "nav-link";
    string marsrutoKlase = "nav-link";
    string registracijosKlase = "nav-link";
    string prisijungimoKlase = "nav-link";
    string sportoPrekiuKlase = "nav-link";
    string treniruociuKlase = "nav-link dropdown-toggle";

    if (valdiklis == "SportoVietos" && veiksmas == "Marsrutas")
    {
        marsrutoKlase = "nav-link active";
    }
    else if (valdiklis == "SportoVietos")
    {
        sportoVietuKlase = "nav-link active";
    }
    else if (valdiklis == "SportoPrekes")
    {
        sportoPrekiuKlase = "nav-link active";
    }
    else if (valdiklis == "TreniruociuProgramos" || valdiklis == "Treniruotes")
    {
        treniruociuKlase = "nav-link dropdown-toggle active";
    }
    else if (veiksmas == "Registracija")
    {
        registracijosKlase = "nav-link active";
    }
    else if (veiksmas == "Prisijungimas")
    {
        prisijungimoKlase = "nav-link active";
    }
}
<!DOCTYPE html>
<html lang="lt">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"] – Viskas Sportui</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Barlow:wght@400;600;700&display=swap" />
    <link rel="stylesheet" href="~/css/site.css" />
</head>
<body>
    <div class="prototipo-juosta">
        3-iojo laboratorinio GUI prototipas
    </div>

    <nav class="navbar navbar-expand-lg">
        <div class="container">
            <a class="navbar-brand" asp-controller="Home" asp-action="Index">
                <span class="logo-taskas"></span>Viskas Sportui
            </a>
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#meniu"
                    aria-controls="meniu" aria-expanded="false" aria-label="Meniu">
                <span class="navbar-toggler-icon"></span>
            </button>

            <div class="collapse navbar-collapse" id="meniu">
                <ul class="navbar-nav me-auto">
                    <!-- Sporto vietų ir maršrutų posistemė (Mantas) -->
                    @if (role == "Administratorius")
                    {
                        @* Administratoriui: išskleidžiamas meniu su peržiūra ir įvedimu *@
                        <li class="nav-item dropdown">
                            <a class="@sportoVietuKlase dropdown-toggle" href="#" role="button" data-bs-toggle="dropdown" aria-expanded="false">Sporto vietos</a>
                            <ul class="dropdown-menu">
                                <li><a class="dropdown-item" asp-controller="SportoVietos" asp-action="Perziura">Peržiūrėti sporto vietas</a></li>
                                <li><a class="dropdown-item" asp-controller="SportoVietos" asp-action="Ivesti">Įvesti sporto vietą</a></li>
                            </ul>
                        </li>
                    }
                    else
                    {
                        <li class="nav-item">
                            <a class="@sportoVietuKlase" asp-controller="SportoVietos" asp-action="Perziura">Sporto vietos</a>
                        </li>
                    }
                    <li class="nav-item">
                        <a class="@marsrutoKlase" asp-controller="SportoVietos" asp-action="Marsrutas">Maršruto sudarymas</a>
                    </li>
                    <li class="nav-item">
                        <a class="@sportoPrekiuKlase" asp-controller="SportoPrekes" asp-action="Perziura">Sporto prekės</a>
                    </li>
                    <!-- Sporto prekių ir kainų palyginimo posistemė (Povilas): meniu punktai pridedami čia -->

                    <!-- Treniruočių planavimo posistemė (Kostas): meniu punktai pridedami čia -->
                    @if (role != null)
                    {
                        <li class="nav-item dropdown">
                            <a class="@treniruociuKlase" href="#" role="button" data-bs-toggle="dropdown" aria-expanded="false">Treniruočių planavimas</a>
                            <ul class="dropdown-menu">
                                <li><a class="dropdown-item" asp-controller="Treniruotes" asp-action="IntensyvumoSkaiciavimas">Intensyvumo skaičiavimas</a></li>
                                <li><a class="dropdown-item" asp-controller="TreniruociuProgramos" asp-action="Perziura">Treniruočių programos</a></li>
                                <li><a class="dropdown-item" asp-controller="Treniruotes" asp-action="Sudaryti">Treniruotės sudarymas</a></li>
                            </ul>
                        </li>
                    }
                    <!-- Sporto renginių posistemė (Pijus): meniu punktai pridedami čia -->

                </ul>

                <!-- Sisteminės funkcijos: registracija, prisijungimas, atsijungimas -->
                <ul class="navbar-nav align-items-lg-center">
                    @if (role == null)
                    {
                        <li class="nav-item">
                            <a class="@registracijosKlase" asp-controller="Paskyros" asp-action="Registracija">Registruotis</a>
                        </li>
                        <li class="nav-item">
                            <a class="@prisijungimoKlase" asp-controller="Paskyros" asp-action="Prisijungimas">Prisijungti</a>
                        </li>
                    }
                    else
                    {
                        <li class="nav-item">
                            @if (role == "Administratorius")
                            {
                                <span class="navbar-text me-3">Administratorius</span>
                            }
                            else
                            {
                                <span class="navbar-text me-3">Registruotas naudotojas</span>
                            }
                        </li>
                        <li class="nav-item">
                            <form method="post" asp-controller="Paskyros" asp-action="Atsijungti">
                                <button type="submit" class="btn btn-outline-secondary btn-sm">Atsijungti</button>
                            </form>
                        </li>
                    }
                </ul>
            </div>
        </div>
    </nav>

    <main class="container py-4">
        @RenderBody()
    </main>

    <footer class="py-3 text-center text-muted small">
        © 2026 komanda „Baltų pr. 16“ · Informacinių sistemų pagrindai (P170B114)
    </footer>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
