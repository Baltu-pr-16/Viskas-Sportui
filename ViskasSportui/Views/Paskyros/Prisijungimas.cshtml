@* Prisijungimo langas (3.13 pav.) *@
@{
    ViewData["Title"] = "Prisijungimas";
    string role = Context.Request.Cookies["Role"];
}

<div class="row justify-content-center">
    <div class="col-md-7 col-lg-5">
        <h1 class="h3 mb-3">Prisijungimas</h1>

        @if (role != null)
        {
            <div class="alert alert-warning">Funkcija prieinama tik svečiui.</div>
        }
        else
        {
            <partial name="_Pranesimai" />

            <form method="post" asp-action="Prisijungimas" class="card card-body">
                <div class="mb-3">
                    <label for="elPastas" class="form-label">El. paštas</label>
                    <input id="elPastas" name="elPastas" type="email" class="form-control" />
                </div>
                <div class="mb-3">
                    <label for="slaptazodis" class="form-label">Slaptažodis</label>
                    <input id="slaptazodis" name="slaptazodis" type="password" class="form-control" />
                </div>
                <button type="submit" class="btn btn-success">Prisijungti</button>
            </form>

            <div class="card card-body mt-3 small bg-light">
                <strong>Testinės paskyros:</strong>
                @foreach (DemoPaskyra paskyra in DemoDuomenys.Paskyros)
                {
                    <div>@paskyra.ElPastas / @paskyra.Slaptazodis – @paskyra.Role</div>
                }
            </div>
        }
    </div>
</div>
